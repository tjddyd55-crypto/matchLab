  publicUnmatchedListEnabled Boolean   @default(false)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  applicationFormTemplate ApplicationFormTemplate? @relation(fields: [applicationFormTemplateId], references: [id], onDelete: SetNull)

  divisions         EventDivision[]
  paymentSetting    EventPaymentSetting?
  images            EventImage[]
  gymFeeSettings    GymEventFeeSetting[]
  staffAccessLinks  EventStaffAccessLink[]
  liveStreams       EventLiveStream[]
  applications      EventApplication[]
  applicationBatches EventApplicationBatch[]
  applicationDocuments ApplicationDocument[]
  brackets          Bracket[]
  bracketChangeLogs BracketChangeLog[]
  matchResults      MatchResult[]
  notifications     Notification[]
  guardianConsents  GuardianConsent[]
  fighterConsents   FighterConsent[]
  judgeOfficials    JudgeOfficial[]
  judgeCredentials  JudgeAccessCredential[]
  judgeAssignments  JudgeMatchAssignment[]
  judgeScorecards   JudgeScorecard[]
  courts            EventCourt[]

  @@index([organizerId])
  @@index([status])
  @@index([eventDate])
  @@index([applicationFormTemplateId])

DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# 데모 계정 스크립트 (`npm run setup:demo-users`) — Supabase 정책상 1234가 거절되면 123456 등으로 지정
DEMO_PASSWORD=1234

SUPABASE_CONSENT_SIGNATURE_BUCKET=consent-signatures
SUPABASE_EVENT_IMAGE_BUCKET=event-images
SUPABASE_PROFILE_IMAGE_BUCKET=profile-images
SUPABASE_APPLICATION_FORM_BUCKET=application-forms
SUPABASE_APPLICATION_DOCUMENT_BUCKET=application-documents
# 협회 회원사 가입 안내·증빙 파일 (private bucket 필수 — public URL 금지)
SUPABASE_MEMBER_GYM_FILES_BUCKET=member-gym-files

NEXT_PUBLIC_APP_URL=http://localhost:3000

# 네이버클라우드 Maps (공개 페이지 행사 안내 「오시는 길」)
# Client ID — 프론트 지도 embed (빌드 시 번들 포함)
NEXT_PUBLIC_NAVER_MAP_NCP_KEY_ID=

# Client Secret — 서버 Geocoding API 전용 (브라우저 노출 금지)
NAVER_MAP_NCP_KEY_SECRET=

# --- MATCHON messaging (DRY_RUN defaults; secrets stay empty) ---
MATCHON_MESSAGING_ENABLED=true
MATCHON_MESSAGING_DRY_RUN=true
MATCHON_MESSAGING_ALLOW_REAL_SEND=false
MATCHON_MESSAGING_ADMIN_UI_ENABLED=true
MATCHON_MESSAGING_GYM_UI_ENABLED=false
MATCHON_MESSAGING_PROVIDER_TIMEOUT_MS=10000
MATCHON_MESSAGING_MAX_BATCH_SIZE=100
MATCHON_MESSAGING_SMS_FALLBACK_ENABLED=false
MATCHON_ALIGO_SMS_ENABLED=false
MATCHON_ALIGO_SMS_API_KEY=
MATCHON_ALIGO_SMS_USER_ID=
MATCHON_ALIGO_SMS_SENDER=
MATCHON_ALIGO_SMS_BASE_URL=
MATCHON_ALIGO_KAKAO_ENABLED=false
MATCHON_ALIGO_KAKAO_API_KEY=
MATCHON_ALIGO_KAKAO_USER_ID=
MATCHON_ALIGO_KAKAO_SENDER_KEY=
MATCHON_ALIGO_KAKAO_CHANNEL_ID=
MATCHON_ALIGO_KAKAO_BASE_URL=

# --- MATCHON phone verification / auth SMS (mock defaults; Production real-send off) ---
# Feature flags: Production default false until Aligo is ready. Development default true.
MATCHON_PHONE_VERIFICATION_ENABLED=true
MATCHON_PASSWORD_RESET_PHONE_ENABLED=true
# Admin-issued one-time password reset links (SMS-independent; Production default off)
MATCHON_ADMIN_PASSWORD_RESET_LINK_ENABLED=true
MATCHON_ADMIN_PASSWORD_RESET_TTL_MS=1800000
MATCHON_ADMIN_PASSWORD_RESET_PEPPER=
MATCHON_AUTH_SMS_PROVIDER=mock
MATCHON_AUTH_SMS_DRY_RUN=true
MATCHON_AUTH_SMS_ALLOW_REAL_SEND=false
MATCHON_AUTH_SMS_E2E_INBOX_ENABLED=true
MATCHON_PHONE_VERIFICATION_PEPPER=
# Optional auth-specific Aligo overrides (fallback: MATCHON_ALIGO_SMS_*)
MATCHON_AUTH_ALIGO_API_KEY=
MATCHON_AUTH_ALIGO_USER_ID=
MATCHON_AUTH_ALIGO_SENDER=
MATCHON_AUTH_ALIGO_BASE_URL=

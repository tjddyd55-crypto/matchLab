// --- Models -----------------------------------------------------------------

/// 내부 PK는 cuid. Supabase Auth `user.id`(UUID)는 `authUserId`로 연결한다 (`roles-permissions.md`).
model User {
  id          String   @id @default(cuid())
  authUserId  String?  @unique
  /// Supabase signIn용(선수는 synthetic internal email, 화면 미노출)
  email       String?  @unique
  /// 선수 일반 아이디 로그인(전역 unique, lowercase 저장)
  loginId     String?  @unique
  phone       String?
  name        String
  role        UserRole
  mustChangePassword Boolean  @default(false)
  passwordIssuedAt   DateTime?
  passwordResetAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer Organizer?
  ownedGym  Gym?     @relation("GymOwner")
  gymStaff  GymStaff?

  fighter Fighter?

  registrationSubmissionsPending FighterRegistrationSubmission[] @relation("RegistrationPendingUser")

  notifications Notification[]
  auditLogs     AuditLog[] @relation("AuditLogActor")
  phoneVerifications PhoneVerification[] @relation("PhoneVerificationUser")

  paymentsConfirmed       EventApplicationPayment[] @relation("PaymentConfirmer")
  inviteLinksCreated      GymInviteLink[]           @relation("InviteLinkCreator")
  applicationsApplied     EventApplication[]        @relation("ApplicationApplicator")
  bracketChangeLogs       BracketChangeLog[]        @relation("BracketChangeActor")
  matchResultsConfirmed   MatchResult[]             @relation("MatchResultConfirmer")
  matchResultChangeLogs   MatchResultChangeLog[]    @relation("MatchResultChangeActor")
  applicationFormTemplatesCreated ApplicationFormTemplate[] @relation("ApplicationFormTemplateCreator")
  applicationBatchesSubmitted     EventApplicationBatch[]   @relation("BatchSubmitter")

  associationJoinLinksCreated            AssociationJoinLink[]                   @relation("AssociationJoinLinkCreator")
  associationMemberGymApplicationReviews AssociationMemberGymApplicationReview[] @relation("MemberGymApplicationReviewer")
  associationJoinLinkAttachmentsUploaded AssociationJoinLinkAttachment[]         @relation("JoinLinkAttachmentUploader")
  associationMemberGymApplicationsCreated AssociationMemberGymApplication[]      @relation("MemberGymApplicationCreator")
  associationMemberGymOwnerInvitesCreated AssociationMemberGym[]                  @relation("MemberGymOwnerInviteCreator")
  associationApplicationsReviewed         AssociationApplication[]               @relation("AssociationApplicationReviewer")
  gymApplicationsReviewed                 GymApplication[]                       @relation("GymApplicationReviewer")
  associationGymConnectionRequestsReviewed AssociationGymConnectionRequest[]     @relation("AssociationGymConnectionReviewer")
  associationGymConnectionRequestsMade     AssociationGymConnectionRequest[]     @relation("AssociationGymConnectionRequester")

  fighterAccountSetupTokensCreated   FighterAccountSetupToken[]   @relation("FighterAccountSetupTokenCreator")
  fighterPasswordResetTokensCreated  FighterPasswordResetToken[]  @relation("FighterPasswordResetTokenCreator")
  fighterPasswordResetTokens         FighterPasswordResetToken[]  @relation("FighterPasswordResetTokenUser")

  gymStaffAccountSetupTokensCreated  GymStaffAccountSetupToken[]  @relation("GymStaffAccountSetupTokenCreator")
  gymStaffPasswordResetTokensCreated GymStaffPasswordResetToken[] @relation("GymStaffPasswordResetTokenCreator")
  gymStaffPasswordResetTokens        GymStaffPasswordResetToken[] @relation("GymStaffPasswordResetTokenUser")

  gymPersonalSchedulesCreated   GymPersonalSchedule[] @relation("GymPersonalScheduleCreator")
  gymPersonalSchedulesUpdated   GymPersonalSchedule[] @relation("GymPersonalScheduleUpdater")
  gymPersonalSchedulesCompleted GymPersonalSchedule[] @relation("GymPersonalScheduleCompleter")
  gymPersonalSchedulesCancelled GymPersonalSchedule[] @relation("GymPersonalScheduleCanceller")

  gymGroupClassesCreated   GymGroupClass[] @relation("GymGroupClassCreator")
  gymGroupClassesUpdated   GymGroupClass[] @relation("GymGroupClassUpdater")
  gymGroupClassesCompleted GymGroupClass[] @relation("GymGroupClassCompleter")
  gymGroupClassesCancelled GymGroupClass[] @relation("GymGroupClassCanceller")
  gymGroupClassParticipationsCreated   GymGroupClassParticipation[] @relation("GymGroupClassParticipationCreator")
  gymGroupClassParticipationsCancelled GymGroupClassParticipation[] @relation("GymGroupClassParticipationCanceller")

  gymMemberPortalsCreated GymMemberPortal[] @relation("GymMemberPortalCreator")

  desktopSupportInquiriesResolved DesktopSupportInquiry[] @relation("DesktopSupportInquiryResolver")

  adminPasswordResetLinks         AdminPasswordResetLink[] @relation("AdminPasswordResetLinkUser")
  adminPasswordResetLinksIssued   AdminPasswordResetLink[] @relation("AdminPasswordResetLinkIssuer")
  adminPasswordResetLinksRevoked  AdminPasswordResetLink[] @relation("AdminPasswordResetLinkRevoker")
}

model Organizer {
  id        String           @id @default(cuid())
  userId    String           @unique
  name      String
  type      OrganizerType
  status    OrganizerStatus  @default(pending)
  /// 공개 홈 파트너 영역용 로고 (event-images 공개 버킷 path/URL)
  logoPath  String?
  logoUrl   String?
  /// @deprecated 메인 하단 자동 노출에 사용하지 않음. 필드 유지(호환). 신규 저장은 false.
  publicLogoVisible Boolean  @default(false)
  websiteUrl String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]
  divisionTemplates DivisionTemplate[]
  applicationFormTemplates ApplicationFormTemplate[]
  creditWallet       OrganizerCreditWallet?
  creditLedgers      OrganizerCreditLedger[]
  creditPayments     OrganizerCreditPayment[]

  associationJoinLinks             AssociationJoinLink[]
  associationMemberGymApplications AssociationMemberGymApplication[]
  associationMemberGyms            AssociationMemberGym[]
  associationMemberGymSettings     AssociationMemberGymSettings?
  associationApplicationsCreated   AssociationApplication[] @relation("AssociationApplicationCreatedOrganizer")
  associationGymConnectionRequests AssociationGymConnectionRequest[]
}

model Gym {
  id          String    @id @default(cuid())
  ownerUserId String    @unique
  name        String
  phone       String?
  address     String?
  status      GymStatus @default(active)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ownerUser User @relation("GymOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  fighters                  Fighter[]
  fighterHistories          FighterGymHistory[]
  inviteLinks               GymInviteLink[]
  registrationSubmissions   FighterRegistrationSubmission[]
  applications              EventApplication[]
  applicationBatches        EventApplicationBatch[]
  applicationDocuments      ApplicationDocument[]
  matchResults              MatchResult[]                    @relation("MatchResultFighterGym")
  matchResultsAsOpponentGym MatchResult[]                    @relation("MatchResultOpponentGym")
  gymEventFeeSettings       GymEventFeeSetting[]

  associationMemberGyms            AssociationMemberGym[]
  associationMemberGymApplications AssociationMemberGymApplication[] @relation("MemberGymApplicationLinkedGym")
  gymApplicationsCreated           GymApplication[]                  @relation("GymApplicationCreatedGym")
  associationGymConnectionRequests AssociationGymConnectionRequest[]

  gymMembers          GymMember[]
  gymMembershipPlans  GymMembershipPlan[]
  gymMemberSubscriptions GymMemberSubscription[]
  gymMemberPayments   GymMemberPayment[]
  gymAttendanceKiosks GymAttendanceKiosk[]
  gymMemberAttendances GymMemberAttendance[]
  gymManualSales      GymManualSale[]
  gymPaymentRefunds   GymPaymentRefund[]
  gymReceivables      GymReceivable[]

  matchonMessageTemplates  MatchonMessageTemplate[]
  matchonMessageDispatches MatchonMessageDispatch[]
  matchonMessageRecipients MatchonMessageRecipient[]

  gymStaffs                 GymStaff[]
  gymStaffMemberAssignments GymStaffMemberAssignment[]
  gymPersonalSchedules      GymPersonalSchedule[]
  gymGroupClasses           GymGroupClass[]
  gymGroupClassParticipations GymGroupClassParticipation[]
  gymMemberPortals          GymMemberPortal[]
  gymMemberPortalSessions   GymMemberPortalSession[]
}

model Fighter {
  id               String        @id @default(cuid())
  fighterCode      String        @unique
  userId           String?       @unique
  currentGymId     String?
  /// 체육관 회원(사람 SSOT)과의 선택적 1:1 — additive, nullable
  gymMemberId      String?       @unique
  name             String
  birthDate        DateTime
  /// MVP는 자유 문자열 — 추후 Gender enum 분리 가능
  gender           String
  phone            String
  height           Float?
  weight           Float?
  profileImageUrl  String?
  /// 등록 제출 시점 보존 — 보호자 동의 정책 판단용 (미입력 시 연령만으로 판단)
  schoolName       String?
  grade            String?
  guardianName     String?
  guardianPhone    String?
  /// 체육관 등록 시 참고용 주 종목 (대회 부문과 별도)
  primarySport     String?
  recordWin        Int           @default(0)
  recordLoss       Int           @default(0)
  recordDraw       Int           @default(0)
  status           FighterStatus @default(active)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  currentGym Gym?  @relation(fields: [currentGymId], references: [id], onDelete: SetNull)
  gymMember  GymMember? @relation(fields: [gymMemberId], references: [id], onDelete: SetNull)

  gymHistories      FighterGymHistory[]
  applications      EventApplication[]
  guardianConsents  GuardianConsent[]   @relation("GuardianConsentFighter")
  fighterConsents   FighterConsent[]
  applicationDocuments ApplicationDocument[]

  matchesAsRed    BracketMatch[] @relation("MatchRed")
  matchesAsBlue   BracketMatch[] @relation("MatchBlue")
  matchesAsWinner BracketMatch[] @relation("MatchWinner")
  matchesAsLoser  BracketMatch[] @relation("MatchLoser")

  matchResults           MatchResult[] @relation("MatchResultFighter")
  matchResultsAsOpponent MatchResult[] @relation("MatchResultOpponent")

  fighterProfile FighterProfile?

  accountSetupTokens   FighterAccountSetupToken[]
  passwordResetTokens  FighterPasswordResetToken[]

  @@index([birthDate, gender, phone])
  @@index([currentGymId])
}

/// 체육관에 등록된 모든 사람의 기본 정보 SSOT (일반 회원 + 선수 회원)
model GymMember {
  id                     String         @id @default(cuid())
  gymId                  String
  memberNumber           String
  name                   String
  /// 화면 표시용 원본/하이픈 포함 가능
  phone                  String
  /// 숫자만 정규화 — unique 강제 없음 (가족 공용번호 허용)
  normalizedPhone        String
  birthDate              DateTime?
  gender                 String?
  email                  String?
  postalCode             String?
  address                String?
  addressDetail          String?
  emergencyContactName   String?
  emergencyContactPhone  String?
  guardianName           String?
  guardianPhone          String?
  joinedAt               DateTime       @default(now())
  status                 GymMemberStatus @default(active)
  primarySport           String?
  rankName               String?
  memo                   String?
  /// 향후 문자 수신 거부 (SMS 자동화는 1차 범위 외)
  smsOptOut              Boolean        @default(false)
  profileImagePath       String?
  createdByUserId        String?
  updatedByUserId        String?
  deletedAt              DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  gym           Gym                      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  fighter       Fighter?
  subscriptions GymMemberSubscription[]
  payments      GymMemberPayment[]
  attendances   GymMemberAttendance[]
  receivables   GymReceivable[]
  manualSales   GymManualSale[]
  staffAssignments   GymStaffMemberAssignment[]
  personalSchedules  GymPersonalSchedule[]
  groupClassParticipations GymGroupClassParticipation[]
  portalSessions     GymMemberPortalSession[]

  @@unique([gymId, memberNumber])
  @@index([gymId, deletedAt])
  @@index([gymId, status])
  @@index([gymId, phone])
  @@index([gymId, normalizedPhone])
  @@index([gymId, name])
}

/// 체육관 선생님·강사·데스크 직원 (User role=gym_staff 와 선택적 연결)
model GymStaff {
  id               String       @id @default(cuid())
  gymId            String
  userId           String?      @unique
  name             String
  phone            String
  normalizedPhone  String
  email            String?
  staffRole        GymStaffRole @default(instructor)
  title            String?
  profileImagePath String?
  colorKey         String?
  isActive         Boolean      @default(true)
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  gym   Gym   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  memberAssignments   GymStaffMemberAssignment[]
  accountSetupTokens  GymStaffAccountSetupToken[]
  passwordResetTokens GymStaffPasswordResetToken[]
  personalSchedules   GymPersonalSchedule[]
  instructedGroupClasses GymGroupClass[]

  @@index([gymId, deletedAt])
  @@index([gymId, isActive])
  @@index([gymId, normalizedPhone])
  @@index([gymId, name])
}

/// 체육관 그룹수업 (개인 PT와 분리 · 정원·대기)
model GymGroupClass {
  id                 String                  @id @default(cuid())
  gymId              String
  title              String
  description        String?
  instructorStaffId  String?
  startsAt           DateTime
  endsAt             DateTime
  capacity           Int?
  location           String?
  status             GymGroupClassStatus     @default(scheduled)
  visibility         GymGroupClassVisibility @default(members_only)
  colorKey           String?
  createdByUserId    String
  updatedByUserId    String?
  completedAt        DateTime?
  completedByUserId  String?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String?
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  gym             Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  instructorStaff GymStaff? @relation(fields: [instructorStaffId], references: [id], onDelete: SetNull)
  createdByUser   User      @relation("GymGroupClassCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  updatedByUser   User?     @relation("GymGroupClassUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  completedByUser User?     @relation("GymGroupClassCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)
  cancelledByUser User?     @relation("GymGroupClassCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  participations  GymGroupClassParticipation[]

  @@index([gymId, startsAt])
  @@index([instructorStaffId, startsAt])
  @@index([gymId, status, startsAt])
  @@index([gymId, deletedAt])
}

model GymGroupClassParticipation {
  id               String                           @id @default(cuid())
  gymId            String
  gymGroupClassId  String
  gymMemberId      String
  status           GymGroupClassParticipationStatus @default(attending)
  waitlistOrder    Int?
  respondedAt      DateTime                         @default(now())
  checkedInAt      DateTime?
  cancelledAt      DateTime?
  cancelledByUserId String?
  createdByUserId  String?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  gym             Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymGroupClass   GymGroupClass @relation(fields: [gymGroupClassId], references: [id], onDelete: Cascade)
  gymMember       GymMember    @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  cancelledByUser User?        @relation("GymGroupClassParticipationCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  createdByUser   User?        @relation("GymGroupClassParticipationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([gymGroupClassId, gymMemberId])
  @@index([gymGroupClassId, status])
  @@index([gymMemberId, status])
  @@index([gymId, status])
}

/// 선생님–회원 개인 PT·상담 등 1:1 일정 (그룹수업은 GymGroupClass)
model GymPersonalSchedule {
  id                 String                     @id @default(cuid())
  gymId              String
  gymStaffId         String
  gymMemberId        String
  title              String
  scheduleType       GymPersonalScheduleType    @default(personal_training)
  startsAt           DateTime
  endsAt             DateTime
  status             GymPersonalScheduleStatus  @default(scheduled)
  location           String?
  memo               String?
  colorKey           String?
  createdByUserId    String
  updatedByUserId    String?
  completedAt        DateTime?
  completedByUserId  String?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  cancellationReason String?
  deletedAt          DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  gym             Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymStaff        GymStaff  @relation(fields: [gymStaffId], references: [id], onDelete: Cascade)
  gymMember       GymMember @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  createdByUser   User      @relation("GymPersonalScheduleCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  updatedByUser   User?     @relation("GymPersonalScheduleUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  completedByUser User?     @relation("GymPersonalScheduleCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)
  cancelledByUser User?     @relation("GymPersonalScheduleCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  @@index([gymId, startsAt])
  @@index([gymStaffId, startsAt])
  @@index([gymMemberId, startsAt])
  @@index([gymId, status, startsAt])
  @@index([gymId, deletedAt])
}

/// 선생님–회원 담당 관계
model GymStaffMemberAssignment {
  id             String                 @id @default(cuid())
  gymId          String
  gymStaffId     String
  gymMemberId    String
  assignmentType GymStaffAssignmentType @default(GENERAL)
  startedAt      DateTime               @default(now())
  endedAt        DateTime?
  isPrimary      Boolean                @default(false)
  memo           String?
  deletedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  gym       Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymStaff  GymStaff  @relation(fields: [gymStaffId], references: [id], onDelete: Cascade)
  gymMember GymMember @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)

  @@index([gymId, deletedAt])
  @@index([gymStaffId, deletedAt])
  @@index([gymMemberId, deletedAt])
  @@index([gymMemberId, isPrimary, deletedAt])
}

/// 선생님 계정 설정 링크 (DB에는 tokenHash만)
model GymStaffAccountSetupToken {
  id              String    @id @default(cuid())
  gymStaffId      String
  userId          String?
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())

  gymStaff      GymStaff @relation(fields: [gymStaffId], references: [id], onDelete: Cascade)
  createdByUser User     @relation("GymStaffAccountSetupTokenCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([gymStaffId])
  @@index([expiresAt])
}

/// 선생님 비밀번호 재설정 링크 (DB에는 tokenHash만)
model GymStaffPasswordResetToken {
  id              String    @id @default(cuid())
  userId          String
  gymStaffId      String
  tokenHash       String    @unique
  /// gym_admin_link | self_service (후속)
  requestSource   String
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  user          User     @relation("GymStaffPasswordResetTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  gymStaff      GymStaff @relation(fields: [gymStaffId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation("GymStaffPasswordResetTokenCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([gymStaffId])
  @@index([expiresAt])
}

/// 체육관 입구 출석 키오스크 (공개 token hash 기반)
model GymAttendanceKiosk {
  id                   String                           @id @default(cuid())
  gymId                String
  name                 String
  /// raw token은 URL에만 — DB에는 sha256 hex
  publicTokenHash      String                           @unique
  isActive             Boolean                          @default(true)
  /// 이용권 만료 회원도 출석 기록 허용 (안내 메시지)
  allowExpiredMember   Boolean                          @default(true)
  /// 휴회 회원도 출석 기록 허용 (안내 메시지)
  allowPausedMember    Boolean                          @default(true)
  duplicatePolicy      GymAttendanceKioskDuplicatePolicy @default(once_per_day)
  lastUsedAt           DateTime?
  createdByUserId      String
  revokedAt            DateTime?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt

  gym         Gym                   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  attendances GymMemberAttendance[]

  @@index([gymId, isActive])
  @@index([gymId, revokedAt])
}

/// 체육관 회원 전용 포털 입구 링크 (공개 token hash — Gym당 활성 0..1)
model GymMemberPortal {
  id              String    @id @default(cuid())
  gymId           String
  /// raw token은 생성 응답·URL에만 — DB에는 sha256 hex
  publicTokenHash String    @unique
  isActive        Boolean   @default(true)
  createdByUserId String
  lastRotatedAt   DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  gym           Gym                      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdByUser User                     @relation("GymMemberPortalCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  sessions      GymMemberPortalSession[]

  @@index([gymId, isActive])
  @@index([gymId, revokedAt])
}

/// 회원 포털 확인 세션 (HttpOnly cookie의 raw session token → hash)
model GymMemberPortalSession {
  id                String    @id @default(cuid())
  gymMemberPortalId String
  gymId             String
  gymMemberId       String
  sessionTokenHash  String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  lastSeenAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  portal    GymMemberPortal @relation(fields: [gymMemberPortalId], references: [id], onDelete: Cascade)
  gym       Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymMember GymMember       @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)

  @@index([gymMemberPortalId, revokedAt])
  @@index([gymMemberId, expiresAt])
  @@index([gymId, expiresAt])
}

/// 체육관 회원 출석 — GymMember 귀속 (Fighter 비SSOT)
model GymMemberAttendance {
  id                       String                     @id @default(cuid())
  gymId                    String
  gymMemberId              String
  /// 실제 출석 시각
  attendedAt               DateTime
  /// Asia/Seoul 달력일 — UTC date-only(자정)로 저장. 같은 날 중복 SSOT
  attendanceDate           DateTime
  source                   GymMemberAttendanceSource
  kioskSessionId           String?
  createdByUserId          String?
  note                     String?
  /// 출석 시점 이용권 표시 상태 스냅샷 (active/expired/paused/…)
  membershipStatusSnapshot String?
  deletedAt                DateTime?
  cancelledByUserId        String?
  cancellationReason       String?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  gym       Gym                  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymMember GymMember            @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  kiosk     GymAttendanceKiosk?  @relation(fields: [kioskSessionId], references: [id], onDelete: SetNull)

  @@unique([gymId, gymMemberId, attendanceDate])
  @@index([gymId, attendanceDate])
  @@index([gymMemberId, attendanceDate])
  @@index([gymId, attendedAt])
  @@index([gymId, deletedAt])
}

/// 체육관별 이용권 상품
model GymMembershipPlan {
  id            String                   @id @default(cuid())
  gymId         String
  name          String
  durationType  GymMembershipDurationType
  durationValue Int?
  price         Int                      @default(0)
  description   String?
  sortOrder     Int                      @default(0)
  isActive      Boolean                  @default(true)
  deletedAt     DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  gym           Gym                     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  subscriptions GymMemberSubscription[]

  @@index([gymId, deletedAt])
  @@index([gymId, isActive])
}

/// 회원에게 적용된 이용권 (상품명·가격 snapshot)
model GymMemberSubscription {
  id                String                      @id @default(cuid())
  gymId             String
  gymMemberId       String
  planId            String?
  planNameSnapshot  String
  priceSnapshot     Int                         @default(0)
  startedAt         DateTime
  endsAt            DateTime?
  status            GymMemberSubscriptionStatus @default(active)
  pausedAt          DateTime?
  resumedAt         DateTime?
  cancelledAt       DateTime?
  memo              String?
  createdByUserId   String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  gym     Gym                        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member  GymMember                  @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  plan    GymMembershipPlan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  pauses  GymMemberSubscriptionPause[]
  payments GymMemberPayment[]

  @@index([gymMemberId, status, endsAt])
  @@index([gymId, status])
}

/// 이용권 휴회 이력
model GymMemberSubscriptionPause {
  id             String    @id @default(cuid())
  subscriptionId String
  pausedAt       DateTime
  resumeAt       DateTime?
  resumedAt      DateTime?
  extendEndsAt   Boolean   @default(true)
  reason         String?
  createdByUserId String?
  createdAt      DateTime  @default(now())

  subscription GymMemberSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

/// 회비 납부 내역 (카드·계좌 평문 저장 금지) — 체육관 매출 SSOT의 회원 결제 축
model GymMemberPayment {
  id              String                 @id @default(cuid())
  gymId           String
  gymMemberId     String
  subscriptionId  String?
  /// 미수금 납부 연결 (선택)
  receivableId    String?
  paidAt          DateTime
  /// 실제 납부금액 (매출 포함 기준)
  amount          Int
  /// 정가(선택) — 없으면 amount만 사용
  listPrice       Int?
  discountAmount  Int                    @default(0)
  paymentMethod   GymMemberPaymentMethod @default(cash)
  status          GymMemberPaymentStatus @default(paid)
  /// null = 미분류
  category        GymSalesCategory?
  memo            String?
  cancelledAt     DateTime?
  createdByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  gym          Gym                    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member       GymMember              @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  subscription GymMemberSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  receivable   GymReceivable?         @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  refunds      GymPaymentRefund[]

  @@index([gymMemberId, paidAt])
  @@index([gymId, paidAt])
  @@index([gymId, status, paidAt])
  @@index([receivableId])
}

/// 회원 미연결 가능 수기 매출
model GymManualSale {
  id              String                 @id @default(cuid())
  gymId           String
  gymMemberId     String?
  title           String
  category        GymSalesCategory       @default(other)
  soldAt          DateTime
  amount          Int
  listPrice       Int?
  discountAmount  Int                    @default(0)
  paymentMethod   GymMemberPaymentMethod @default(cash)
  status          GymMemberPaymentStatus @default(paid)
  memo            String?
  cancelledAt     DateTime?
  createdByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  gym     Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member  GymMember?         @relation(fields: [gymMemberId], references: [id], onDelete: SetNull)
  refunds GymPaymentRefund[]

  @@index([gymId, soldAt])
  @@index([gymId, status, soldAt])
}

/// 환불 — 원결제/수기매출에 귀속. 환불일 기준 매출 차감
model GymPaymentRefund {
  id              String                 @id @default(cuid())
  gymId           String
  paymentId       String?
  manualSaleId    String?
  amount          Int
  refundedAt      DateTime
  refundMethod    GymMemberPaymentMethod @default(cash)
  reason          String?
  memo            String?
  cancelledAt     DateTime?
  createdByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  gym        Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  payment    GymMemberPayment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  manualSale GymManualSale?    @relation(fields: [manualSaleId], references: [id], onDelete: Cascade)

  @@index([gymId, refundedAt])
  @@index([paymentId])
  @@index([manualSaleId])
}

/// 미수금 — 매출 합계에 포함하지 않음. 납부 시 GymMemberPayment 생성
model GymReceivable {
  id              String              @id @default(cuid())
  gymId           String
  gymMemberId     String
  title           String
  category        GymSalesCategory?
  totalAmount     Int
  paidAmount      Int                 @default(0)
  dueDate         DateTime?
  status          GymReceivableStatus @default(pending)
  subscriptionId  String?
  memo            String?
  cancelledAt     DateTime?
  createdByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  gym      Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member   GymMember          @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  payments GymMemberPayment[]

  @@index([gymId, status])
  @@index([gymMemberId, status])
  @@index([gymId, dueDate])
}

/// 선수 공개 개인 프로필 (주최자 공개 풀·체육관 DB와 별도)
model FighterProfile {
  id               String   @id @default(cuid())
  fighterId        String   @unique
  profileImageUrl  String?
  profileImagePath String?
  displayName      String?
  slug             String   @unique
  bio              String?
  snsInstagram     String?
  snsYoutube       String?
  snsTiktok        String?
  isPublic         Boolean  @default(false)
  publicEnabledAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fighter Fighter @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  @@index([isPublic])

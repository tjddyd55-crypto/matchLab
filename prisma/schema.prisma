// =============================================================================
// 격투기 대회 운영 플랫폼 — Prisma 스키마 (database.md / status-machine.md / api-contract.md 정합)
// - 전적 원천: MatchResult / Fighter.record* 는 캐시
// - 입금 진실: EventApplicationPayment / EventApplication.paymentStatus 는 집계 캐시
// - 주민번호·스트림 키 필드 없음
// - GuardianConsent.signatureImagePath: private storage 객체 경로(URL 아님)
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ------------------------------------------------------------------

enum UserRole {
  admin
  organizer
  gym
  fighter
}

enum GymStatus {
  active
  suspended
  archived
}

enum FighterStatus {
  active
  inactive
  duplicate_review
  archived
}

enum OrganizerType {
  association
  gym
  company
  individual
}

enum OrganizerStatus {
  pending
  active
  suspended
  archived
}

enum EventStatus {
  draft
  open
  closed
  bracket_ready
  ongoing
  finished
  cancelled
}

enum ApplicationStatus {
  pending
  approved
  rejected
  cancelled
}

/// 대회 당일 현장 확인(체크인) — 신청 승인과 별개
enum CheckInStatus {
  pending
  checked_in
  no_show
  withdrawn
  disqualified
}

/// 계체 결과 — 현장 확인과 별개
enum WeighInStatus {
  pending
  pass
  fail
  manual_pass
  manual_fail
}

/// 계체 실패 후 주최측 처리
enum WeighInFailureResolution {
  pending
  proceed_with_handicap
  cancel_match
}

/// 신청 취소 주체 (status=cancelled/rejected 시 구분)
enum ApplicationCancellationSource {
  gym
  organizer
  system
}

enum PaymentStatus {
  unpaid
  pending_check
  paid
  refunded
  waived
}

/// 주최자 크레딧 ledger 거래 유형
enum CreditLedgerType {
  payment_charge
  manual_charge
  debit_participant
  refund_participant
  adjustment
}

enum CreditPaymentStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

enum BracketType {
  single_elimination
  match_list
}

enum BracketStatus {
  draft
  published
  ongoing
  finished
}

enum BracketMatchStatus {
  waiting
  called
  ongoing
  finished
  delayed
  cancelled
}

enum BracketMatchOutcomeStyle {
  decision
  ko
  tko
  submission
  disqualification
  walkover
  forfeit
  draw
  no_contest
}

enum MatchRecordOutcome {
  win
  loss
  draw
  no_contest
}

enum MatchRecordStatus {
  pending
  confirmed
  corrected
  voided
}

enum InviteLinkType {
  fighter_registration
  guardian_consent
}

enum InviteLinkStatus {
  active
  paused
  expired
  revoked
}

enum FighterRegistrationSubmissionStatus {
  submitted
  duplicate_review
  approved
  rejected
}

enum DuplicateCheckStatus {
  unchecked
  clear
  suspected
  confirmed_duplicate
}

enum ConsentStatus {
  draft
  completed
  revoked
  superseded
}

enum EventApplicationBatchStatus {
  draft
  submitted
  organizer_review
  approved
  rejected
  cancelled
}

enum ApplicationDocumentStatus {
  draft
  waiting_athlete_signature
  waiting_guardian_signature
  completed
  submitted
  rejected
}

enum FighterConsentType {
  event_application
  application_document_signature
  streaming
}

enum FighterConsentStatus {
  draft
  pending
  completed
  expired
  revoked
}

enum LivePlatform {
  youtube
  vimeo
  twitch
  custom
}

enum StreamType {
  main
  mat
}

enum LiveStreamStatus {
  scheduled
  live
  ended
  hidden
}

enum NotificationType {
  bracket_changed
  match_changed
  result_confirmed
  application_status_changed
  payment_status_changed
  consent_required
  live_started
  event_notice
}

enum AuditAction {
  event_status_changed
  permission_changed
  admin_adjustment
  payment_high_risk_change
  system_setting_changed
  gym_owner_connected
  gym_owner_replaced
  gym_owner_access_suspended
  gym_owner_access_restored
  gym_owner_invited
  gym_owner_invite_cancelled
}

enum BracketChangeType {
  bracket_created
  bracket_published
  bracket_unpublished
  fighter_assigned
  fighter_removed
  opponent_changed
  bye_assigned
  match_order_changed
  global_order_changed
  mat_changed
  match_status_changed
  winner_changed
  result_type_changed
  match_cancelled
  bracket_reset
}

/// 토너먼트 다음 매치 슬롯 — DB에서는 enum, 애플리케이션에서도 문자열 하드코딩 금지
enum NextMatchSlot {
  red
  blue
}

// --- Models -----------------------------------------------------------------

/// 내부 PK는 cuid. Supabase Auth `user.id`(UUID)는 `authUserId`로 연결한다 (`roles-permissions.md`).
model User {
  id          String   @id @default(cuid())
  authUserId  String?  @unique
  /// Supabase signIn용(선수는 synthetic internal email, 화면 미노출)
  email       String?  @unique
  /// 선수 일반 아이디 로그인(전역 unique, lowercase 저장)
  loginId     String?  @unique
  phone       String?
  name        String
  role        UserRole
  mustChangePassword Boolean  @default(false)
  passwordIssuedAt   DateTime?
  passwordResetAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer Organizer?
  ownedGym  Gym?     @relation("GymOwner")

  fighter Fighter?

  registrationSubmissionsPending FighterRegistrationSubmission[] @relation("RegistrationPendingUser")

  notifications Notification[]
  auditLogs     AuditLog[] @relation("AuditLogActor")

  paymentsConfirmed       EventApplicationPayment[] @relation("PaymentConfirmer")
  inviteLinksCreated      GymInviteLink[]           @relation("InviteLinkCreator")
  applicationsApplied     EventApplication[]        @relation("ApplicationApplicator")
  bracketChangeLogs       BracketChangeLog[]        @relation("BracketChangeActor")
  matchResultsConfirmed   MatchResult[]             @relation("MatchResultConfirmer")
  matchResultChangeLogs   MatchResultChangeLog[]    @relation("MatchResultChangeActor")
  applicationFormTemplatesCreated ApplicationFormTemplate[] @relation("ApplicationFormTemplateCreator")
  applicationBatchesSubmitted     EventApplicationBatch[]   @relation("BatchSubmitter")

  associationJoinLinksCreated            AssociationJoinLink[]                   @relation("AssociationJoinLinkCreator")
  associationMemberGymApplicationReviews AssociationMemberGymApplicationReview[] @relation("MemberGymApplicationReviewer")
  associationJoinLinkAttachmentsUploaded AssociationJoinLinkAttachment[]         @relation("JoinLinkAttachmentUploader")
  associationMemberGymApplicationsCreated AssociationMemberGymApplication[]      @relation("MemberGymApplicationCreator")
  associationMemberGymOwnerInvitesCreated AssociationMemberGym[]                  @relation("MemberGymOwnerInviteCreator")
}

model Organizer {
  id        String           @id @default(cuid())
  userId    String           @unique
  name      String
  type      OrganizerType
  status    OrganizerStatus  @default(pending)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]
  divisionTemplates DivisionTemplate[]
  applicationFormTemplates ApplicationFormTemplate[]
  creditWallet       OrganizerCreditWallet?
  creditLedgers      OrganizerCreditLedger[]
  creditPayments     OrganizerCreditPayment[]

  associationJoinLinks             AssociationJoinLink[]
  associationMemberGymApplications AssociationMemberGymApplication[]
  associationMemberGyms            AssociationMemberGym[]
  associationMemberGymSettings     AssociationMemberGymSettings?
}

model Gym {
  id          String    @id @default(cuid())
  ownerUserId String    @unique
  name        String
  phone       String?
  address     String?
  status      GymStatus @default(active)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ownerUser User @relation("GymOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  fighters                  Fighter[]
  fighterHistories          FighterGymHistory[]
  inviteLinks               GymInviteLink[]
  registrationSubmissions   FighterRegistrationSubmission[]
  applications              EventApplication[]
  applicationBatches        EventApplicationBatch[]
  applicationDocuments      ApplicationDocument[]
  matchResults              MatchResult[]                    @relation("MatchResultFighterGym")
  matchResultsAsOpponentGym MatchResult[]                    @relation("MatchResultOpponentGym")
  gymEventFeeSettings       GymEventFeeSetting[]

  associationMemberGyms            AssociationMemberGym[]
  associationMemberGymApplications AssociationMemberGymApplication[] @relation("MemberGymApplicationLinkedGym")
}

model Fighter {
  id               String        @id @default(cuid())
  fighterCode      String        @unique
  userId           String?       @unique
  currentGymId     String?
  name             String
  birthDate        DateTime
  /// MVP는 자유 문자열 — 추후 Gender enum 분리 가능
  gender           String
  phone            String
  height           Float?
  weight           Float?
  profileImageUrl  String?
  /// 등록 제출 시점 보존 — 보호자 동의 정책 판단용 (미입력 시 연령만으로 판단)
  schoolName       String?
  grade            String?
  guardianName     String?
  guardianPhone    String?
  /// 체육관 등록 시 참고용 주 종목 (대회 부문과 별도)
  primarySport     String?
  recordWin        Int           @default(0)
  recordLoss       Int           @default(0)
  recordDraw       Int           @default(0)
  status           FighterStatus @default(active)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  currentGym Gym?  @relation(fields: [currentGymId], references: [id], onDelete: SetNull)

  gymHistories      FighterGymHistory[]
  applications      EventApplication[]
  guardianConsents  GuardianConsent[]   @relation("GuardianConsentFighter")
  fighterConsents   FighterConsent[]
  applicationDocuments ApplicationDocument[]

  matchesAsRed    BracketMatch[] @relation("MatchRed")
  matchesAsBlue   BracketMatch[] @relation("MatchBlue")
  matchesAsWinner BracketMatch[] @relation("MatchWinner")
  matchesAsLoser  BracketMatch[] @relation("MatchLoser")

  matchResults           MatchResult[] @relation("MatchResultFighter")
  matchResultsAsOpponent MatchResult[] @relation("MatchResultOpponent")

  fighterProfile FighterProfile?

  @@index([birthDate, gender, phone])
  @@index([currentGymId])
}

/// 선수 공개 개인 프로필 (주최자 공개 풀·체육관 DB와 별도)
model FighterProfile {
  id               String   @id @default(cuid())
  fighterId        String   @unique
  profileImageUrl  String?
  profileImagePath String?
  displayName      String?
  slug             String   @unique
  bio              String?
  snsInstagram     String?
  snsYoutube       String?
  snsTiktok        String?
  isPublic         Boolean  @default(false)
  publicEnabledAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fighter Fighter @relation(fields: [fighterId], references: [id], onDelete: Cascade)

  @@index([isPublic])
}

model FighterGymHistory {
  id        String    @id @default(cuid())
  fighterId String
  gymId     String
  startDate DateTime  @default(now())
  endDate   DateTime?
  status    String
  /// 로그인한 주최자 전용 매칭 후보 목록 공개 (체육관 소속 단위)
  isPublicToOrganizers Boolean  @default(false)
  publicEnabledAt      DateTime?
  publicDisabledAt     DateTime?
  publicMemo           String?
  /// 체육관 내부 메모 (주최자 공개·대회 신청 snapshot과 무관)
  gymInternalMemo      String?
  createdAt DateTime  @default(now())

  fighter Fighter @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([fighterId])
  @@index([gymId])
  @@index([gymId, isPublicToOrganizers])
}

model Event {
  id                       String      @id @default(cuid())
  organizerId              String
  title                    String
  description              String?
  location                 String?
  roadAddress              String?
  jibunAddress             String?
  detailAddress            String?
  postalCode               String?
  locationName             String?
  eventDate                DateTime
  registrationStartDate    DateTime
  registrationEndDate      DateTime
  status                   EventStatus @default(draft)
  posterUrl                String?
  publicSlug               String      @unique
  photoRecordingEnabled    Boolean     @default(false)
  videoRecordingEnabled    Boolean     @default(false)
  liveStreamingEnabled     Boolean     @default(false)
  streamingNoticeText      String?
  streamingConsentRequired Boolean     @default(false)
  spectatorAccessEnabled   Boolean     @default(false)
  spectatorAccessStartAt   DateTime?
  spectatorAccessEndAt     DateTime?
  spectatorAccessToken     String?     @unique
  applicationFormTemplateId String?
  /// 공개 페이지에 미매칭(대기) 명단 표시 여부
  publicUnmatchedListEnabled Boolean   @default(false)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  applicationFormTemplate ApplicationFormTemplate? @relation(fields: [applicationFormTemplateId], references: [id], onDelete: SetNull)

  divisions         EventDivision[]
  paymentSetting    EventPaymentSetting?
  images            EventImage[]
  gymFeeSettings    GymEventFeeSetting[]
  staffAccessLinks  EventStaffAccessLink[]
  liveStreams       EventLiveStream[]
  applications      EventApplication[]
  applicationBatches EventApplicationBatch[]
  applicationDocuments ApplicationDocument[]
  brackets          Bracket[]
  bracketChangeLogs BracketChangeLog[]
  matchResults      MatchResult[]
  notifications     Notification[]
  guardianConsents  GuardianConsent[]
  fighterConsents   FighterConsent[]
  judgeOfficials    JudgeOfficial[]
  judgeCredentials  JudgeAccessCredential[]
  judgeAssignments  JudgeMatchAssignment[]
  judgeScorecards   JudgeScorecard[]
  courts            EventCourt[]

  @@index([organizerId])
  @@index([status])
  @@index([eventDate])
  @@index([applicationFormTemplateId])
}

model EventImage {
  id        String   @id @default(cuid())
  eventId   String
  imageUrl  String
  imagePath String?
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model DivisionTemplate {
  id          String   @id @default(cuid())
  organizerId String
  title       String
  sportType   String?
  description String?
  items       Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
}

model GymEventFeeSetting {
  id               String   @id @default(cuid())
  gymId            String
  eventId          String
  athleteFeeAmount Int
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  gym   Gym   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([gymId, eventId])
  @@index([gymId])
  @@index([eventId])
}

model EventStaffAccessLink {
  id                    String    @id @default(cuid())
  eventId               String
  token                 String    @unique
  label                 String
  accessCode            String?
  role                  String
  canChangeMatchStatus  Boolean   @default(true)
  canRecordOutcomeDraft Boolean   @default(true)
  canConfirmResult      Boolean   @default(false)
  expiresAt             DateTime?
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  event                 Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bracketChangeLogs     BracketChangeLog[]     @relation("BracketChangeStaffLink")
  matchResultChangeLogs MatchResultChangeLog[]   @relation("MatchResultChangeStaffLink")

  @@index([eventId])
  @@index([token])
}

model EventDivision {
  id               String   @id @default(cuid())
  eventId          String
  sportType        String
  ruleType         String?
  gender           String?
  ageGroup         String?
  weightClass      String?
  weightClassName  String?
  weightLimitText  String?
  skillLevel       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  applications EventApplication[]
  brackets     Bracket[]
  courtRules   EventCourtDivisionRule[]

  @@index([eventId])
}

/// 대회 경기장(코트) — hard delete 금지, isActive로 비활성
model EventCourt {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event        Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  divisionRules EventCourtDivisionRule[]
  matches      BracketMatch[]

  @@index([eventId])
  @@index([eventId, sortOrder])
}

/// 경기장별 경기구분(division)·체급 배정 규칙
model EventCourtDivisionRule {
  id               String   @id @default(cuid())
  eventId          String
  courtId          String
  /// null이면 경기구분 무관(체급 단독 배정)
  divisionId       String?
  /// null/빈값이면 해당 경기구분 전체, 값이 있으면 해당 체급만
  weightClassLabel String?
  priority         Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  court    EventCourt     @relation(fields: [courtId], references: [id], onDelete: Cascade)
  division EventDivision? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([courtId])
  @@index([divisionId])
  @@index([courtId, divisionId])
}

/// 신청 단위 입금 UI 필터용 캐시 — 진실 원천은 EventApplicationPayment
model EventApplication {
  id                         String             @id @default(cuid())
  eventId                    String
  divisionId                 String
  gymId                      String
  fighterId                  String
  status                     ApplicationStatus  @default(pending)
  paymentStatus              PaymentStatus      @default(unpaid)
  applicationProfileImageUrl String?
  fighterSnapshot            Json
  gymSnapshot                Json
  /// 신청 시점 체크박스·스트리밍 동의 등 스냅샷 (전자서명 원본 아님)
  applicationAgreementSnapshot Json?
  appliedByUserId            String?
  appliedAt                  DateTime?
  memo                       String?
  /// 현장 확인·계체 운영 메모 (신청 메모와 분리)
  fieldMemo                  String?
  checkInStatus              CheckInStatus @default(pending)
  weighInStatus              WeighInStatus @default(pending)
  weighInWeightKg            Float?
  weighInFailureResolution   WeighInFailureResolution @default(pending)
  /// 계체 실패 후 경기진행 시 관람·대진표에 표시할 핸디캡 안내 (public 노출 가능 문구만)
  handicapNote               String?
  /// 실격 처리 시 사유
  disqualificationReason     String?
  /// status가 cancelled/rejected일 때 취소 주체
  cancellationSource         ApplicationCancellationSource?
  applicationBatchId         String?
  applicationDocumentId      String?            @unique
  /// 참가 승인 시 크레딧 차감 추적
  creditChargedAt            DateTime?
  creditChargeLedgerId       String?
  creditChargeAmount         Int                @default(0)
  creditRefundedAt           DateTime?
  creditRefundLedgerId       String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  division      EventDivision  @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  gym           Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  fighter       Fighter        @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  appliedByUser User?          @relation("ApplicationApplicator", fields: [appliedByUserId], references: [id], onDelete: SetNull)
  applicationBatch EventApplicationBatch? @relation(fields: [applicationBatchId], references: [id], onDelete: SetNull)
  applicationDocument ApplicationDocument? @relation(fields: [applicationDocumentId], references: [id], onDelete: SetNull)

  payments EventApplicationPayment[]
  guardianConsents GuardianConsent[] @relation("GuardianConsentApplication")
  fighterConsents  FighterConsent[]  @relation("FighterConsentApplication")

  @@unique([eventId, fighterId, divisionId])
  @@index([eventId])
  @@index([divisionId])
  @@index([gymId])
  @@index([fighterId])
  @@index([appliedByUserId])
  @@index([applicationBatchId])
}

model EventPaymentSetting {
  id             String    @id @default(cuid())
  eventId        String    @unique
  feeAmount      Int
  bankName       String
  accountNumber  String
  accountHolder  String
  depositorRule  String?
  paymentDueDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

/// 입금 상태의 진실 원천 — 서비스에서 Application.paymentStatus 와 트랜잭션 내 동기화
model EventApplicationPayment {
  id                 String        @id @default(cuid())
  eventApplicationId String
  amount             Int
  paymentMethod      String        @default("bank_transfer")
  paymentStatus      PaymentStatus @default(unpaid)
  depositorName      String?
  confirmedByUserId  String?
  confirmedAt        DateTime?
  memo               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  eventApplication EventApplication @relation(fields: [eventApplicationId], references: [id], onDelete: Cascade)
  confirmedByUser  User?            @relation("PaymentConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@index([eventApplicationId])
  @@index([paymentStatus])
}

model GymInviteLink {
  id              String           @id @default(cuid())
  gymId           String
  token           String           @unique
  type            InviteLinkType
  expiresAt       DateTime?
  maxUses         Int?
  usedCount       Int              @default(0)
  status          InviteLinkStatus @default(active)
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  gym         Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdByUser User  @relation("InviteLinkCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  submissions FighterRegistrationSubmission[]

  @@index([gymId])
  @@index([token])
  @@index([status])
}

model FighterRegistrationSubmission {
  id                   String                              @id @default(cuid())
  gymId                String
  inviteLinkId         String?
  name                 String
  birthDate            DateTime
  gender               String
  phone                String
  height               Float?
  weight               Float?
  profileImageUrl      String?
  schoolName           String?
  grade                String?
  guardianName         String?
  guardianPhone        String?
  /// 등록 링크 제출 시 선수 로그인 아이디(승인 전)
  loginId              String?
  /// 제출 시 생성된 pending User (승인 전 로그인·대기 화면용)
  pendingUserId        String?  @unique
  status               FighterRegistrationSubmissionStatus @default(submitted)
  duplicateCheckStatus DuplicateCheckStatus                @default(unchecked)
  submittedAt          DateTime                            @default(now())
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt

  gym         Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  inviteLink  GymInviteLink? @relation(fields: [inviteLinkId], references: [id], onDelete: SetNull)
  pendingUser User?          @relation("RegistrationPendingUser", fields: [pendingUserId], references: [id], onDelete: SetNull)
  guardianConsents GuardianConsent[]

  @@index([gymId])
  @@index([loginId])
  @@index([birthDate, gender, phone])
  @@index([status])
}

/// 서명은 Supabase private bucket 객체 경로만 저장 (공개 URL 금지)
model GuardianConsent {
  id                      String        @id @default(cuid())
  fighterId               String?
  registrationSubmissionId String?
  eventId                 String?
  eventApplicationId      String?
  guardianName            String
  guardianPhone           String
  relationship            String?
  documentTitle           String
  documentVersion         String
  consentStatus           ConsentStatus @default(draft)
  signatureImagePath      String?
  signedAt                DateTime?
  ipAddress               String?
  userAgent               String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  fighter               Fighter?                     @relation("GuardianConsentFighter", fields: [fighterId], references: [id], onDelete: SetNull)
  registrationSubmission FighterRegistrationSubmission? @relation(fields: [registrationSubmissionId], references: [id], onDelete: SetNull)
  event                 Event?                       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventApplication      EventApplication?            @relation("GuardianConsentApplication", fields: [eventApplicationId], references: [id], onDelete: SetNull)
  linkedDocument        ApplicationDocument?         @relation("DocumentGuardianConsent")

  @@index([fighterId])
  @@index([registrationSubmissionId])
  @@index([eventId])
  @@index([eventApplicationId])
}

/// 주최측 공식 신청서 PDF 템플릿 — 관리자/운영팀이 좌표·source mapping 세팅
model ApplicationFormTemplate {
  id                   String   @id @default(cuid())
  organizerId          String?
  title                String
  description          String?
  originalPdfPath      String?
  originalPdfFileName  String?
  fieldsJson           Json     @default("[]")
  repeatGroupsJson     Json     @default("[]")
  manualFieldsJson     Json?
  consentMappingJson   Json?
  isActive             Boolean  @default(true)
  createdByAdminUserId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organizer      Organizer? @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  createdByAdmin User?      @relation("ApplicationFormTemplateCreator", fields: [createdByAdminUserId], references: [id], onDelete: SetNull)

  events               Event[]
  batches              EventApplicationBatch[]
  applicationDocuments ApplicationDocument[]

  @@index([organizerId])
  @@index([isActive])
}

/// 체육관이 한 대회에 제출하는 신청 묶음
model EventApplicationBatch {
  id                        String                      @id @default(cuid())
  eventId                   String
  gymId                     String
  applicationFormTemplateId String
  documentNo                String?
  status                    EventApplicationBatchStatus @default(draft)
  submittedByUserId         String?
  submittedAt               DateTime?
  totalFighterCount         Int                         @default(0)
  organizerFeePerFighter    Int?
  organizerTotalFee         Int?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt

  event       Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  gym         Gym                     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  template    ApplicationFormTemplate @relation(fields: [applicationFormTemplateId], references: [id], onDelete: Restrict)
  submittedBy User?                   @relation("BatchSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  applications EventApplication[]
  documents    ApplicationDocument[]

  @@index([eventId])
  @@index([gymId])
  @@index([status])
  @@index([applicationFormTemplateId])
}

/// 선수 1명당 공식 신청서 작성 문서
model ApplicationDocument {
  id                      String                   @id @default(cuid())
  eventId                 String
  gymId                   String
  fighterId               String
  applicationId           String?
  batchId                 String?
  templateId              String
  status                  ApplicationDocumentStatus @default(draft)
  formValuesJson          Json                     @default("{}")
  documentSnapshotJson    Json?
  generatedPdfPath        String?
  originalTemplatePdfPath String
  athleteConsentId        String?                  @unique
  guardianConsentId       String?                  @unique
  completedAt             DateTime?
  submittedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  event           Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  gym             Gym                     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  fighter         Fighter                 @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  batch           EventApplicationBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  template        ApplicationFormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  athleteConsent  FighterConsent?         @relation("DocumentAthleteConsent", fields: [athleteConsentId], references: [id], onDelete: SetNull)
  guardianConsent GuardianConsent?        @relation("DocumentGuardianConsent", fields: [guardianConsentId], references: [id], onDelete: SetNull)

  eventApplication EventApplication?

  @@index([eventId])
  @@index([gymId])
  @@index([fighterId])
  @@index([batchId])
  @@index([templateId])
  @@index([status])
}

/// 선수 본인 서명/동의 — 대회 신청 문서 단위
model FighterConsent {
  id                    String               @id @default(cuid())
  fighterId             String
  eventId               String
  eventApplicationId    String?
  token                 String               @unique
  consentType           FighterConsentType
  status                FighterConsentStatus @default(draft)
  signerName            String
  signerPhoneMasked     String?
  documentTitle         String
  documentSnapshotJson  Json?
  signatureImagePath    String?
  signedAt              DateTime?
  ipAddress             String?
  userAgent             String?
  expiresAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  fighter            Fighter              @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  event              Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventApplication   EventApplication?    @relation("FighterConsentApplication", fields: [eventApplicationId], references: [id], onDelete: SetNull)
  linkedDocument     ApplicationDocument? @relation("DocumentAthleteConsent")

  @@index([fighterId])
  @@index([eventId])
  @@index([eventApplicationId])
  @@index([status])
}

model Bracket {
  id        String        @id @default(cuid())
  eventId   String
  divisionId String?
  title     String
  type      BracketType
  status    BracketStatus @default(draft)
  isPublic  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  division EventDivision? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  matches      BracketMatch[]
  changeLogs   BracketChangeLog[]
  matchResults MatchResult[]

  @@index([eventId])
  @@index([divisionId])
  @@index([type])
  @@index([status])
}

model BracketMatch {
  id           String               @id @default(cuid())
  bracketId    String
  round        Int?
  roundName    String?
  matchOrder   Int
  globalMatchOrder Int?
  matchNumber  Int?
  matNumber    Int?
  courtId      String?
  /// 경기장 내 표시 순서 (1, 2, 3…)
  courtOrder   Int?
  fighterRedId String?
  fighterBlueId String?
  fighterRedSnapshot   Json?
  fighterBlueSnapshot  Json?
  winnerId     String?
  loserId      String?
  status       BracketMatchStatus   @default(waiting)
  resultType   BracketMatchOutcomeStyle?
  resultMemo   String?
  nextMatchId  String?
  nextMatchSlot NextMatchSlot?
  scheduledStartTime DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  bracket Bracket @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  court   EventCourt? @relation(fields: [courtId], references: [id], onDelete: SetNull)

  fighterRed  Fighter? @relation("MatchRed", fields: [fighterRedId], references: [id], onDelete: SetNull)
  fighterBlue Fighter? @relation("MatchBlue", fields: [fighterBlueId], references: [id], onDelete: SetNull)
  winner      Fighter? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  loser       Fighter? @relation("MatchLoser", fields: [loserId], references: [id], onDelete: SetNull)

  nextMatch   BracketMatch?  @relation("BracketMatchNext", fields: [nextMatchId], references: [id], onDelete: SetNull)
  prevMatches BracketMatch[] @relation("BracketMatchNext")

  matchResults           MatchResult[]
  matchResultChangeLogs  MatchResultChangeLog[] @relation("MRCL_BracketMatch")
  changeLogs             BracketChangeLog[]
  judgeAssignments       JudgeMatchAssignment[]
  judgeScorecards        JudgeScorecard[]

  @@index([bracketId])
  @@index([bracketId, round, matchOrder])
  @@index([globalMatchOrder])
  @@index([matNumber])
  @@index([courtId])
  @@index([courtId, courtOrder])
  @@index([status])
}

model BracketChangeLog {
  id                     String           @id @default(cuid())
  eventId                String
  bracketId              String
  matchId                String?
  changedByUserId        String?
  changedByStaffLinkId   String?
  bracketType            BracketType
  changeType             BracketChangeType
  beforeData             Json?
  afterData              Json?
  reason                 String?
  createdAt              DateTime         @default(now())

  event             Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bracket           Bracket              @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  match             BracketMatch?        @relation(fields: [matchId], references: [id], onDelete: SetNull)
  changedByUser     User?                @relation("BracketChangeActor", fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedByStaffLink EventStaffAccessLink? @relation("BracketChangeStaffLink", fields: [changedByStaffLinkId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([bracketId])
  @@index([matchId])
  @@index([changeType])
}

model MatchResult {
  id                   String               @id @default(cuid())
  eventId              String
  bracketId            String
  matchId              String
  fighterId            String
  opponentFighterId    String?
  gymId                String?
  opponentGymId        String?
  result               MatchRecordOutcome
  resultType           BracketMatchOutcomeStyle?
  eventTitleSnapshot   String
  fighterSnapshot      Json
  opponentSnapshot     Json?
  divisionSnapshot     Json?
  matchDate            DateTime
  status               MatchRecordStatus    @default(pending)
  confirmedByUserId    String?
  confirmedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bracket Bracket       @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  match   BracketMatch  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  fighter Fighter       @relation("MatchResultFighter", fields: [fighterId], references: [id], onDelete: Cascade)
  opponentFighter Fighter? @relation("MatchResultOpponent", fields: [opponentFighterId], references: [id], onDelete: SetNull)
  gym             Gym?    @relation("MatchResultFighterGym", fields: [gymId], references: [id], onDelete: SetNull)
  opponentGym     Gym?    @relation("MatchResultOpponentGym", fields: [opponentGymId], references: [id], onDelete: SetNull)
  confirmedByUser User?   @relation("MatchResultConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  changeLogs MatchResultChangeLog[]

  @@unique([matchId, fighterId])
  @@index([eventId])
  @@index([bracketId])
  @@index([fighterId])
  @@index([status])
  @@index([matchDate])
}

model MatchResultChangeLog {
  id                   String   @id @default(cuid())
  matchResultId        String
  matchId              String
  changedByUserId      String?
  changedByStaffLinkId String?
  beforeResult         Json
  afterResult          Json
  reason               String?
  createdAt            DateTime @default(now())

  matchResult          MatchResult            @relation(fields: [matchResultId], references: [id], onDelete: Cascade)
  match                BracketMatch           @relation("MRCL_BracketMatch", fields: [matchId], references: [id], onDelete: Cascade)
  changedByUser        User?                  @relation("MatchResultChangeActor", fields: [changedByUserId], references: [id], onDelete: SetNull)
  changedByStaffLink   EventStaffAccessLink?  @relation("MatchResultChangeStaffLink", fields: [changedByStaffLinkId], references: [id], onDelete: SetNull)

  @@index([matchResultId])
  @@index([matchId])
}

/// 스트림 키 필드 없음 — watchUrl/embedUrl 만
model EventLiveStream {
  id         String            @id @default(cuid())
  eventId    String
  title      String
  platform   LivePlatform
  streamType StreamType
  matNumber  Int?
  watchUrl   String?
  embedUrl   String?
  status     LiveStreamStatus  @default(scheduled)
  isPublic   Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  eventId   String?
  type      NotificationType
  title     String
  content   String
  /// 인앱 알림에서 이동할 내부·공개 경로(민감 정보 금지). 예: `/gym/applications`, `/events/{slug}/brackets`
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventId])
  @@index([readAt])
}

/// 주최자별 크레딧 지갑 — balance는 ledger 거래로만 변경
model OrganizerCreditWallet {
  id          String   @id @default(cuid())
  organizerId String   @unique
  balance     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer Organizer             @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  ledgers   OrganizerCreditLedger[]
}

model OrganizerCreditLedger {
  id                 String           @id @default(cuid())
  walletId           String
  organizerId        String
  type               CreditLedgerType
  /// 충전·환불: 양수, 차감: 음수
  amount             Int
  balanceAfter       Int
  reason             String
  eventId            String?
  eventApplicationId String?
  paymentId          String?
  paymentRef         String?
  memo               String?
  createdByUserId    String?
  createdAt          DateTime         @default(now())

  wallet    OrganizerCreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  organizer Organizer             @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([organizerId])
  @@index([createdAt])
  @@index([paymentId])
}

model OrganizerCreditPayment {
  id          String              @id @default(cuid())
  organizerId String
  userId      String?
  provider    String              @default("toss")
  orderId     String              @unique
  paymentKey  String?
  amountKrw   Int
  credits     Int
  status      CreditPaymentStatus @default(pending)
  approvedAt  DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?
  refundedAt  DateTime?
  ledgerId    String?             @unique
  memo        String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
  @@index([status])
}

model AuditLog {
  id          String       @id @default(cuid())
  actorUserId String?
  action      AuditAction
  targetType  String
  targetId    String?
  beforeData  Json?
  afterData   Json?
  createdAt   DateTime     @default(now())

  actorUser User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
}

// --- Judge scoring (MVP) — MatchResult와 분리된 심판 채점 근거 데이터 ----------------

enum JudgeScorecardStatus {
  draft
  submitted
  revised
  locked
}

enum JudgeCredentialRole {
  SCORING_JUDGE
  HEAD_JUDGE
  ANNOUNCER
}

enum JudgeScorecardRevisionAction {
  draft_save
  submit
  revise
}

enum JudgeWinnerCorner {
  red
  blue
  draw
  no_contest
  undecided
}

enum JudgeDecisionMethod {
  decision
  ko_tko
  submission
  disqualification
  forfeit
  no_contest
  other
}

/// 대회별 심판 인적 정보(선택) — MVP는 JudgeAccessCredential 중심
model JudgeOfficial {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  role      String?
  phone     String?
  memo      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments JudgeMatchAssignment[]

  @@index([eventId])
  @@index([isActive])
}

/// 심판 접속 계정 — loginId + passwordHash (평문 저장 금지)
model JudgeAccessCredential {
  id           String    @id @default(cuid())
  eventId      String
  loginId      String
  passwordHash String
  displayName  String?
  role         JudgeCredentialRole @default(SCORING_JUDGE)
  verifiedName String?
  birthDate    DateTime? @db.Date
  phone        String?
  organization String?
  identityConfirmedAt        DateTime?
  identityConfirmedIp        String?
  identityConfirmedUserAgent String?
  memo         String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  event       Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments JudgeMatchAssignment[]
  scorecards  JudgeScorecard[]

  @@unique([eventId, loginId])
  @@index([eventId])
  @@index([isActive])
  @@index([role])
}

/// 경기별 심판 배정
model JudgeMatchAssignment {
  id           String   @id @default(cuid())
  eventId      String
  matchId      String
  judgeId      String?
  credentialId String?
  judgeOrder   Int
  isHeadJudge  Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  event      Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  match      BracketMatch           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  judge      JudgeOfficial?         @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  credential JudgeAccessCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([matchId])
  @@index([credentialId])
  @@index([judgeId])
}

/// 심판별 채점표 — MatchResult와 분리
model JudgeScorecard {
  id                 String                @id @default(cuid())
  eventId            String
  matchId            String
  credentialId       String
  judgeName          String
  judgeBirthDateSnapshot String?
  judgeRoleSnapshot  JudgeCredentialRole?
  cornerRedFighterId String?
  cornerBlueFighterId String?
  roundCount         Int
  status             JudgeScorecardStatus  @default(draft)
  redTotal           Int?
  blueTotal          Int?
  winnerCorner       JudgeWinnerCorner     @default(undecided)
  decisionMethod     JudgeDecisionMethod?
  memo               String?
  submittedAt        DateTime?
  submittedIp        String?
  submittedUserAgent String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  event      Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  match      BracketMatch          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  credential JudgeAccessCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  rounds     JudgeRoundScore[]
  changeLogs JudgeScorecardChangeLog[]

  @@unique([matchId, credentialId])
  @@index([eventId])
  @@index([matchId])
  @@index([credentialId])
  @@index([status])
}

/// 채점표 제출·수정 감사 이력 — hard delete 금지
model JudgeScorecardChangeLog {
  id                      String                      @id @default(cuid())
  scorecardId             String
  eventId                 String
  matchId                 String
  credentialId            String
  judgeNameSnapshot       String
  judgeBirthDateSnapshot  String?
  judgeRoleSnapshot       JudgeCredentialRole
  action                  JudgeScorecardRevisionAction
  previousStatus          JudgeScorecardStatus?
  newStatus               JudgeScorecardStatus
  previousRedTotal        Int?
  previousBlueTotal       Int?
  newRedTotal             Int?
  newBlueTotal            Int?
  previousWinnerCorner    JudgeWinnerCorner?
  newWinnerCorner         JudgeWinnerCorner?
  roundsSnapshotJson      Json?
  changedAt               DateTime                    @default(now())
  changedByCredentialId   String
  changedIp               String?
  changedUserAgent        String?

  scorecard JudgeScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  @@index([scorecardId])
  @@index([matchId])
  @@index([credentialId])
  @@index([changedAt])
}

/// 라운드별 점수
model JudgeRoundScore {
  id             String   @id @default(cuid())
  scorecardId    String
  roundNumber    Int
  redScore       Int?
  blueScore      Int?
  redKnockdowns  Int      @default(0)
  blueKnockdowns Int      @default(0)
  redDeductions  Int      @default(0)
  blueDeductions Int      @default(0)
  warningMemo    String?
  roundMemo      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  scorecard JudgeScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  @@unique([scorecardId, roundNumber])
  @@index([scorecardId])
}


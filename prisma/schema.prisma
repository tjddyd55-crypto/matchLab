  gym        Gym?                     @relation(fields: [gymId], references: [id], onDelete: SetNull)
  dispatches MatchonMessageDispatch[]

  @@index([ownerType, gymId, deletedAt])
  @@index([channel, isActive])
  @@index([isApproved])
}

/// MATCHON 전용 발송 요청(dispatch) 스냅샷
model MatchonMessageDispatch {
  id                String                       @id @default(cuid())
  ownerType         MatchonMessageOwnerType
  gymId             String?
  sourceType        MatchonMessageSourceType
  channel           MatchonMessageChannel
  templateId        String?
  title             String?
  subjectSnapshot   String?
  bodySnapshot      String
  requestedCount    Int                          @default(0)
  eligibleCount     Int                          @default(0)
  excludedCount     Int                          @default(0)
  successCount      Int                          @default(0)
  failureCount      Int                          @default(0)
  dryRun            Boolean                      @default(true)
  status            MatchonMessageDispatchStatus @default(draft)
  /// platform | gym:{id} — nullable gymId unique 이슈 회피
  idempotencyScope  String?
  idempotencyKey    String?
  blockedReason     String?
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdByUserId   String?
  metadata          Json?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  gym        Gym?                      @relation(fields: [gymId], references: [id], onDelete: SetNull)
  template   MatchonMessageTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients MatchonMessageRecipient[]

  @@unique([idempotencyScope, idempotencyKey])
  @@index([ownerType, gymId, createdAt])
  @@index([status, createdAt])
  @@index([channel, dryRun])
}

/// MATCHON 전용 수신자 스냅샷 — referenceType/Id는 강결합 FK 없음
model MatchonMessageRecipient {
  id                        String                        @id @default(cuid())
  dispatchId                String
  gymId                     String?
  referenceType             String?
  referenceId               String?
  recipientNameSnapshot     String?
  phoneSnapshot             String
  normalizedPhone           String
  channel                   MatchonMessageChannel
  subjectSnapshot           String?
  bodySnapshot              String
  templateVariablesSnapshot Json?
  status                    MatchonMessageRecipientStatus @default(pending)
  excludedReason            String?
  providerMessageId         String?
  providerCode              String?
  providerMessage           String?
  attemptCount              Int                           @default(0)
  retryable                 Boolean                       @default(false)
  lastAttemptAt             DateTime?
  sentAt                    DateTime?
  deliveredAt               DateTime?
  failedAt                  DateTime?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt

  dispatch MatchonMessageDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  gym      Gym?                   @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([dispatchId, status])
  @@index([normalizedPhone])
  @@index([gymId, createdAt])
  @@index([referenceType, referenceId])
}

// --- MATCHON Manager desktop support inquiries (Stage PC-3, additive) ------

enum DesktopSupportInquiryCategory {
  password_help
  login_issue
  desktop_bug
  general
}

enum DesktopSupportInquirySource {
  desktop
  web
}

enum DesktopSupportInquiryStatus {
  open
  in_progress
  resolved
  closed
}

/// MATCHON Manager / 관리자 문의·비밀번호 찾기 요청 (로그인 전 공개 생성)
model DesktopSupportInquiry {
  id               String                         @id @default(cuid())
  category         DesktopSupportInquiryCategory
  source           DesktopSupportInquirySource    @default(desktop)
  name             String
  loginId          String?
  contact          String
  message          String
  appVersion       String?
  roleHint         String?
  status           DesktopSupportInquiryStatus    @default(open)
  adminNote        String?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  resolvedAt       DateTime?
  resolvedByUserId String?
  deletedAt        DateTime?

  resolvedByUser User? @relation("DesktopSupportInquiryResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([source, createdAt])
  @@index([deletedAt])
}

/// 휴대폰 OTP 인증 (회원가입 신청·비밀번호 재설정). 코드 원문 저장 금지.
enum PhoneVerificationPurpose {
  signup
  password_reset
}

enum PhoneVerificationAccountType {
  association
  gym
}

enum PhoneVerificationStatus {
  pending
  verified
  consumed
  expired
  locked
  cancelled
}

model PhoneVerification {
  id                         String                        @id @default(cuid())
  phoneNormalized            String
  purpose                    PhoneVerificationPurpose
  accountType                PhoneVerificationAccountType?
  /// HMAC-SHA256(code + purpose + phone + pepper) — 원문 금지
  codeHash                   String
  status                     PhoneVerificationStatus       @default(pending)
  expiresAt                  DateTime
  verifiedAt                 DateTime?
  consumedAt                 DateTime?
  attemptCount               Int                           @default(0)
  sendCount                  Int                           @default(0)
  lastSentAt                 DateTime?
  /// 인증 완료 후 단기 토큰 해시 (원문 금지)
  verificationTokenHash      String?                       @unique
  verificationTokenExpiresAt DateTime?
  /// password_reset 바인딩 (normalizeLoginId)
  loginIdNormalized          String?
  userId                     String?
  requestIpHash              String?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt

  user User? @relation("PhoneVerificationUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([phoneNormalized, purpose, status])
  @@index([loginIdNormalized, purpose, status])
  @@index([expiresAt])
  @@index([userId])
}

/// 최고 관리자 발급형 일회용 비밀번호 재설정 링크. 원본 token 저장 금지.
enum AdminPasswordResetAccountType {
  association
  gym
}

enum AdminPasswordResetLinkStatus {
  active
  consumed
  expired
  revoked
}

model AdminPasswordResetLink {
  id                    String                        @id @default(cuid())
  userId                String
  authUserId            String
  accountType           AdminPasswordResetAccountType
  organizerId           String?
  gymId                 String?
  /// SHA-256(token) — 원문 금지
  tokenHash             String                        @unique
  /// URL token → HttpOnly challenge 교환용
  challengeTokenHash    String?                       @unique
  challengeExpiresAt    DateTime?
  status                AdminPasswordResetLinkStatus  @default(active)
  expiresAt             DateTime
  consumedAt            DateTime?
  revokedAt             DateTime?
  issuedByUserId        String
  revokedByUserId       String?
  consumedIpHash        String?
  consumedUserAgentHash String?
  inquiryId             String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  user          User  @relation("AdminPasswordResetLinkUser", fields: [userId], references: [id], onDelete: Cascade)
  issuedByUser  User  @relation("AdminPasswordResetLinkIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  revokedByUser User? @relation("AdminPasswordResetLinkRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([expiresAt])
  @@index([issuedByUserId])
  @@index([inquiryId])
  @@index([status, createdAt])
}

/// 선수 본인 계정 설정 링크 (DB에는 tokenHash만 저장, raw token 금지)
model FighterAccountSetupToken {
  id              String    @id @default(cuid())
  fighterId       String
  /// 기존 미전달 자동 계정 재설정 시 대상 User (없으면 신규 생성)
  userId          String?
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())

  fighter       Fighter @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  createdByUser User    @relation("FighterAccountSetupTokenCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([fighterId])
  @@index([expiresAt])
}

/// 선수 비밀번호 재설정 링크 (DB에는 tokenHash만 저장)
model FighterPasswordResetToken {
  id              String    @id @default(cuid())
  userId          String
  fighterId       String
  tokenHash       String    @unique
  /// self_service | gym_admin_link
  requestSource   String
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  user          User     @relation("FighterPasswordResetTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  fighter       Fighter  @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation("FighterPasswordResetTokenCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([fighterId])
  @@index([expiresAt])
}

model FighterGymHistory {
  id        String    @id @default(cuid())
  fighterId String
  gymId     String
  startDate DateTime  @default(now())
  endDate   DateTime?
  status    String
  /// 로그인한 주최자 전용 매칭 후보 목록 공개 (체육관 소속 단위)
  isPublicToOrganizers Boolean  @default(false)
  publicEnabledAt      DateTime?
  publicDisabledAt     DateTime?
  publicMemo           String?
  /// 체육관 내부 메모 (주최자 공개·대회 신청 snapshot과 무관)
  gymInternalMemo      String?
  createdAt DateTime  @default(now())

  fighter Fighter @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([fighterId])
  @@index([gymId])
  @@index([gymId, isPublicToOrganizers])
}

model Event {
  id                       String      @id @default(cuid())
  organizerId              String
  title                    String
  description              String?
  location                 String?
  roadAddress              String?
  jibunAddress             String?
  detailAddress            String?
  postalCode               String?
  locationName             String?
  eventDate                DateTime
  registrationStartDate    DateTime
  registrationEndDate      DateTime
  status                   EventStatus @default(draft)
  posterUrl                String?
  publicSlug               String      @unique
  photoRecordingEnabled    Boolean     @default(false)
  videoRecordingEnabled    Boolean     @default(false)
  liveStreamingEnabled     Boolean     @default(false)
  streamingNoticeText      String?
  streamingConsentRequired Boolean     @default(false)
  spectatorAccessEnabled   Boolean     @default(false)
  spectatorAccessStartAt   DateTime?
  spectatorAccessEndAt     DateTime?
  spectatorAccessToken     String?     @unique
  applicationFormTemplateId String?

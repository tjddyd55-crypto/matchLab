  pending
  on_hold
  suspended
  withdrawn
}

enum AssociationMemberGymApplicationAttachmentType {
  business_registration
  representative_photo
  gym_exterior_photo
  gym_interior_photo
  instructor_certificate
  dan_certificate
  association_certificate
  coach_certificate
  referee_certificate
  location_proof
  identity_document
  paper_application_scan
  applicant_signature
  other

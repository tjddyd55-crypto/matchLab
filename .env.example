DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# 데모 계정 스크립트 (`npm run setup:demo-users`) — Supabase 정책상 1234가 거절되면 123456 등으로 지정
DEMO_PASSWORD=1234

SUPABASE_CONSENT_SIGNATURE_BUCKET=consent-signatures
SUPABASE_EVENT_IMAGE_BUCKET=event-images
SUPABASE_PROFILE_IMAGE_BUCKET=profile-images
SUPABASE_APPLICATION_FORM_BUCKET=application-forms
SUPABASE_APPLICATION_DOCUMENT_BUCKET=application-documents

NEXT_PUBLIC_APP_URL=http://localhost:3000

# 네이버클라우드 Maps JavaScript API (공개 페이지 행사 안내 「오시는 길」 지도 embed)
# 필수(프론트): Client ID — Hero/입금 안내에는 지도 버튼 없음, 오시는 길 섹션만 사용
NEXT_PUBLIC_NAVER_MAP_NCP_KEY_ID=

# 선택(서버용, 브라우저 노출 금지): Client Secret — 현재 프론트 지도 embed에는 사용하지 않음
# NAVER_MAP_NCP_KEY_SECRET=

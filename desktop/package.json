{
  "name": "matchon-manager",
  "version": "1.0.3",
  "private": true,
  "description": "MATCHON 주최측 및 체육관 관리자 프로그램",
  "author": "MATCHON",
  "main": "dist/main.js",
  "productName": "MATCHON Manager",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run icons && tsc -p tsconfig.json && node scripts/copy-static.cjs",
    "dev": "tsx scripts/dev.ts",
    "start": "electron .",
    "package": "npm run build && electron-builder --win nsis dir",
    "package:nsis": "npm run build && electron-builder --win nsis",
    "package:dir": "npm run build && electron-builder --win dir"
  },
  "build": {
    "appId": "com.matchon.manager",
    "productName": "MATCHON Manager",
    "copyright": "Copyright © MATCHON",
    "directories": {
      "output": "out-pc2",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "assets/icon.ico"
      },
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/tjddyd55-crypto/matchLab/releases/latest/download/"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "MATCHON-Manager-${version}-${arch}.${ext}",
      "executableName": "MATCHON Manager",
      "signAndEditExecutable": true,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MATCHON Manager",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "artifactName": "MATCHON-Manager-Setup-${version}.${ext}",
      "uninstallDisplayName": "MATCHON Manager",
      "include": "nsis/installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "sharp": "^0.35.3",
    "to-ico": "^1.1.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
